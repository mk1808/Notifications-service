    "generate-react-cli": "^9.1.0",
    "i18next": "^25.7.0",
    "i18next-http-backend": "^3.0.2",
    "lucide-react": "^0.548.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.3.5",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.4",
    "react-use-websocket": "^4.13.0",
